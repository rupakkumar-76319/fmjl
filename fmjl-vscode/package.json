{
  "name": "fmjl",
  "displayName": "FMJL",
  "description": "FMJL (.fmjl) documents: convert Markdown to FMJL and back, live error checking with one-click fixes, an outline of headings, hovers and go-to-definition for element ids. JSON Lines container, Markdown text, LaTeX formulas, HTML tables.",
  "version": "1.1.0",
  "publisher": "rupakkumar",
  "author": {
    "name": "Rupak Kumar"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rupakkumar-76319/fmjl.git"
  },
  "homepage": "https://github.com/rupakkumar-76319/fmjl#readme",
  "bugs": {
    "url": "https://github.com/rupakkumar-76319/fmjl/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "fmjl",
    "jsonl",
    "markdown",
    "rag",
    "document"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fmjl",
        "aliases": [
          "FMJL"
        ],
        "extensions": [
          ".fmjl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fmjl",
        "scopeName": "source.fmjl",
        "path": "./syntaxes/fmjl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "fmjl.check",
        "title": "FMJL: Check current file"
      },
      {
        "command": "fmjl.fill",
        "title": "FMJL: Fill (fix hashes, counts and missing fields)"
      },
      {
        "command": "fmjl.toFmjl",
        "title": "FMJL: Convert Markdown to .fmjl"
      },
      {
        "command": "fmjl.toMd",
        "title": "FMJL: Convert .fmjl to Markdown"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "fmjl.toFmjl",
          "when": "resourceExtname == .md",
          "group": "fmjl@1"
        },
        {
          "command": "fmjl.toMd",
          "when": "resourceExtname == .fmjl",
          "group": "fmjl@1"
        }
      ],
      "editor/context": [
        {
          "command": "fmjl.toFmjl",
          "when": "resourceExtname == .md",
          "group": "fmjl@1"
        },
        {
          "command": "fmjl.toMd",
          "when": "resourceLangId == fmjl",
          "group": "fmjl@1"
        },
        {
          "command": "fmjl.fill",
          "when": "resourceLangId == fmjl",
          "group": "fmjl@2"
        }
      ],
      "commandPalette": [
        {
          "command": "fmjl.check",
          "when": "editorLangId == fmjl"
        },
        {
          "command": "fmjl.fill",
          "when": "editorLangId == fmjl"
        }
      ]
    }
  },
  "scripts": {
    "test": "node test/roundtrip.js && node test/checker.js"
  }
}
