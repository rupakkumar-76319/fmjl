{
  "name": "fmjl",
  "displayName": "FMJL",
  "description": "FMJL (.fmjl) documents: convert Markdown to FMJL and back, syntax coloring and live error checking. JSON Lines container, Markdown text, LaTeX formulas, HTML tables - one element per line with id, hash, page and permissions.",
  "version": "1.0.0",
  "publisher": "rupakkumar",
  "author": {
    "name": "Rupak Kumar"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rupakkumar-76319/fmjl.git"
  },
  "homepage": "https://github.com/rupakkumar-76319/fmjl#readme",
  "bugs": {
    "url": "https://github.com/rupakkumar-76319/fmjl/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "fmjl",
    "jsonl",
    "markdown",
    "rag",
    "document"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fmjl",
        "aliases": [
          "FMJL"
        ],
        "extensions": [
          ".fmjl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fmjl",
        "scopeName": "source.fmjl",
        "path": "./syntaxes/fmjl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "fmjl.check",
        "title": "FMJL: Check current file"
      },
      {
        "command": "fmjl.toFmjl",
        "title": "FMJL: Convert Markdown to .fmjl"
      },
      {
        "command": "fmjl.toMd",
        "title": "FMJL: Convert .fmjl to Markdown"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "fmjl.toFmjl",
          "when": "resourceExtname == .md",
          "group": "fmjl@1"
        },
        {
          "command": "fmjl.toMd",
          "when": "resourceExtname == .fmjl",
          "group": "fmjl@1"
        }
      ],
      "editor/context": [
        {
          "command": "fmjl.toFmjl",
          "when": "resourceExtname == .md",
          "group": "fmjl@1"
        },
        {
          "command": "fmjl.toMd",
          "when": "resourceLangId == fmjl",
          "group": "fmjl@1"
        }
      ]
    }
  },
  "scripts": {
    "test": "node test/roundtrip.js"
  }
}
